# crypto-intel keys. Copy to .env and fill in. Never commit .env.
#
# The hourly collector needs ONLY the three Supabase values. Everything else is
# optional and the stack degrades to free public endpoints without them
# (python config.py prints exactly what is missing and what it costs).
#
# On the GitHub Actions runner these live in repo secrets, not in a file:
#   gh secret set SUPABASE_URL --repo frankiev22/crypto-intel

# --- required by collect.py -------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=     # publishable, safe in a browser; read-only via RLS
CRYPTO_JOURNAL_SECRET=        # SECRET. gates the append-only journal RPC

# --- optional ---------------------------------------------------------------
CRYPTO_DISCORD_WEBHOOK=       # unset = notify prints instead of posting
HELIUS_API_KEY=
BIRDEYE_API_KEY=
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
CRYPTOPANIC_API_TOKEN=
CRYPTO_PUBLISH_SECRET=
HELIUS_WEBHOOK_SECRET=
CRYPTO_WHALE_SECRET=
CRYPTO_CONFIG_SECRET=
CRYPTO_CRON_SECRET=
